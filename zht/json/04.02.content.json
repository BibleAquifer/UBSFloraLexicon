{
"content_id": "FLORA:4.2.3",
"reference_id": "FLORA:4.2.3",
"version": "1.0.4",
"title": "標題：蘇合香（東方楓香）（liquidambar [Oriental sweetgum, storax]）",
"media_type": "Text",
"index_reference": "4.2.3",
